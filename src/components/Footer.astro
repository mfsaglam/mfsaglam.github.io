---
import { site } from '../data/site';
---
<div class="links">
  <a href={`mailto:${site.email}`}>Email</a>
  <a href={site.github} rel="me">GitHub</a>
  <a href={site.linkedin} rel="me">LinkedIn</a>
  <a href="/rss.xml">RSS</a>
</div>
<footer class="foot mono">
  <span>© {new Date().getFullYear()} {site.name}</span>
  <span>optional analytics · <button id="analytics-preferences" type="button">privacy preferences</button></span>
</footer>
<style>
  #analytics-preferences { color: inherit; font: inherit; background: none; border: 0; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
</style>
